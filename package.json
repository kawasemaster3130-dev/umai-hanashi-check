{
  "name": "umai-hanashi-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "うまい話チェック アプリ（教材『AI投資部、今日から出社。投資編』17章のチェック表をそのまま使えるウェブアプリにしたもの）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
